    "@angular/cli": "~18.2.0",
    "@angular/compiler-cli": "18.2.9",
    "@angular/language-service": "18.2.9",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@nx/cypress": "19.8.9",
    "@nx/eslint-plugin": "19.8.9",
