{
  "name": "ngx-libs-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": ">=20.19",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "scripts": {
    "ng": "nx",
    "start": "nx serve",
    "build": "nx build",
    "affected": "nx affected",
    "affected:apps": "nx affected:apps",
    "affected:build": "nx affected:build",
    "affected:e2e": "nx affected:e2e",
    "affected:lint": "nx affected:lint",
    "affected:test": "nx affected:test",
    "test:coverage:ci": "pnpm jest --coverage",
    "prepare": "husky install",
    "prettier:write": "prettier --write \"**/*.{ts,scss,html}\"",
    "prettier:check": "prettier --check \"**/*.{ts,scss,html}\"",
    "deploy-page": "nx build --prod --output-path docs --base-href .",
    "configure-deploy": "nx generate ngx-deploy-npm:install",
    "ngx-pass-code:test:ci": "pnpm jest ngx-pass-code --coverage",
    "publish:ngx-pass-code": "nx deploy ngx-pass-code",
    "playground:build:prod": "nx build playground --skip-nx-cache --prod --base-href ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "18.2.9",
    "@angular/common": "18.2.9",
    "@angular/compiler": "18.2.9",
