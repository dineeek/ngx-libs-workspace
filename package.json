    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-preset-angular": "14.1.1",
    "lint-staged": "^13.0.3",
    "ng-packagr": "18.2.1",
    "nx": "19.8.9",
    "nx-cloud": "19.1.3",
    "postcss": "^8.4.5",
